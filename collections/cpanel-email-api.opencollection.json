{
  "opencollection": "1.0.0",
  "info": {
    "name": "cPanel U DomainInfo Email API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an email account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:2083/execute/Email/add_pop",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "password",
                "value": "",
                "type": "query"
              },
              {
                "name": "quota",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Create an email account"
        },
        {
          "info": {
            "name": "List email accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:2083/execute/Email/list_pops"
          },
          "docs": "List email accounts"
        }
      ]
    }
  ],
  "bundled": true
}