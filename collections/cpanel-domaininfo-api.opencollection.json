{
  "opencollection": "1.0.0",
  "info": {
    "name": "cPanel U DomainInfo API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "DomainInfo",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List domains on the account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:2083/execute/DomainInfo/list_domains"
          },
          "docs": "List domains on the account"
        }
      ]
    }
  ],
  "bundled": true
}