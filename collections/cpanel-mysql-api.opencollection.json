{
  "opencollection": "1.0.0",
  "info": {
    "name": "cPanel U DomainInfo Mysql API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Mysql",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List MySQL databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{hostname}:2083/execute/Mysql/list_databases"
          },
          "docs": "List MySQL databases"
        }
      ]
    }
  ],
  "bundled": true
}